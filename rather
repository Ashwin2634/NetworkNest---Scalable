@media (max-width: 420px) {
            
       

            #contact_pane,
            #chatbox {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 10;
            }

            #chatbox {
                display: none;           /* Hide chat by default on mobile */
                box-shadow: -2px 0 10px rgba(0,0,0,0.2); /* optional nice effect */
            }

            #contact_pane {
                display: block;
                width: 100%;
                z-index: 20;
            }

            /* Hide logo on very small screens if needed */
            #logo {
                width: 60px;
            }

}